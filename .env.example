# ==============================================================================
# Velora Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials before running:
#   cp .env.example .env
#
# NOTE: NEVER commit your actual .env file to version control.
# ==============================================================================

# --- Database Configuration (PostgreSQL / Neon Cloud) ---
DB_URL=jdbc:postgresql://localhost:5432/velora_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_POOL_SIZE=10

# --- JWT Authentication (Access Token) ---
# Required: 256-bit (32+ bytes) secret key. Generate with: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_at_least_32_bytes_long_min
# Access token expiration in milliseconds (default 15 mins = 900000 ms)
JWT_EXPIRATION_MS=900000

# --- Sessions & Token Expiration ---
REFRESH_TOKEN_TTL=30d
PASSWORD_RESET_TTL=15m

# --- Brevo Transactional Email API (Email OTP 2FA & Password Reset) ---
# Sends via Brevo's HTTPS API, not SMTP - most PaaS hosts block/throttle
# outbound SMTP ports, HTTPS has no such restriction.
# 1. Sign up at https://brevo.com (300 emails/day free)
# 2. Go to: Settings -> SMTP & API -> API Keys tab -> Generate a new API key
BREVO_API_KEY=xkeysib-your_generated_api_key_here
BREVO_FROM_EMAIL=your_verified_sender_email@example.com

# --- Cloudinary (Media Assets & Portfolio Uploads) ---
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# --- Google Sign-In ("Continue with Google") ---
# OAuth 2.0 Client ID from Google Cloud Console (must match the audience in the ID
# tokens the frontend's Google Sign-In SDK produces). Leave blank to disable the feature.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- CORS Settings (Frontend & Mobile Origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19000,http://localhost:8081

# --- Server Port ---
PORT=8080

# --- Vision Studio (AI room transformation) ---
# Provider format is UNVERIFIED against Stability docs; leaving the key blank makes jobs fail safely (no startup error).
STABILITY_API_KEY=
VISION_API_URL=https://api.stability.ai/v2beta/stable-image/generate
VISION_ENGINE=sd3
VISION_DAILY_LIMIT=5
VISION_IMAGE_STRENGTH=0.35
VISION_STALE_AFTER=20m
VISION_TIMEOUT=60s
VISION_NEGATIVE_PROMPT_ENABLED=true
VISION_DUPLICATE_WINDOW=60s
VISION_MIN_SHORT_SIDE=512
VISION_TARGET_PIXELS=1000000
VISION_MAX_INPUT_PIXELS=40000000
VISION_PREPROCESS_CONCURRENCY=2
VISION_PREPROCESS_WAIT=5s
VISION_JPEG_QUALITY=0.92
# Placeholder strengths, not yet calibrated against real room photos
VISION_STRENGTH_PRESERVE_ORIGINAL=0.30
VISION_STRENGTH_BALANCED=0.50
VISION_STRENGTH_CREATIVE=0.70
