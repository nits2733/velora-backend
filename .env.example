# Copy to .env (or export as real env vars) before running the backend.
# NEVER commit a real .env file.

# --- Database ---
DB_URL=jdbc:postgresql://ep-falling-mountain-ayauugew.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=npg_c6L0ejzViJEM
DB_POOL_SIZE=10

# --- JWT ---
# Required. Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-local-secret-key-change-me-please-32bytesmin
# Token lifetime in milliseconds (default 24h)
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Comma-separated list of allowed origins for the mobile app / dev tools
CORS_ALLOWED_ORIGINS=http://localhost:19000,http://localhost:8081

# --- Server ---
PORT=8080
